<van-popup __fn_onClose="{{true}}" bindclose="onClose" closeOnClickOverlay="{{false}}" customStyle="border-radius: 28px 28px 0px 0px;" position="bottom" show="{{isShow}}" zIndex="{{1000}}" wx:if="{{$taroCompReady}}">
    <view class="container">
        <image class="submitresultbg1" src="https://xcxstatic.xybsyw.com/static/submit_result_bg1.png"></image>
        <image class="submitresultbg2" src="https://xcxstatic.xybsyw.com/static/submit_result_bg2.png"></image>
        <view class="topItem">
            <view class="topText">
                <text wx:if="{{lastPageType==1||otherFlag}}">提交成功！</text>
                <text wx:if="{{lastPageType!=1&&!otherFlag}}">签到成功！</text>
                <text wx:if="{{integrateFlag==1}}">获得5积分</text>
            </view>
            <view class="topItem_line"></view>
            <view class="promptText">
                <text wx:if="{{lastPageType==1&&journalType==0&&randomNumber==0}}">悄悄告诉你，你是本班今天第{{submitNum}}个提交的同学~</text>
                <text wx:if="{{lastPageType==1&&journalType==1&&randomNumber==0}}">悄悄告诉你，你是本班这周第{{submitNum}}个提交的同学~{{' '}}</text>
                <text wx:if="{{lastPageType==1&&journalType==2&&randomNumber==0}}">悄悄告诉你，你是本班本月第{{submitNum}}个提交的同学~</text>
                <text wx:if="{{lastPageType==1&&randomNumber==1&&startTraineeDayNum>0}}">本次实习还剩下{{startTraineeDayNum}}天，继续努力鸭~</text>
                <view wx:if="{{lastPageType==1&&randomNumber==1&&startTraineeDayNum<=0}}">(๑•̀ㅂ•́)و✧</view>
                <block wx:if="{{lastPageType!==1&&!otherFlag}}">
                    <text wx:if="{{lastPageType!=1&&signRandomNumber==0}}">悄悄告诉你，你是本班今天第{{signPersonNum}}个签到的同学~</text>
                    <text wx:if="{{lastPageType!=1&&signRandomNumber==1}}">今天是实习的第{{startTraineeDayNum}}天，希望你每一天愉快而有意义</text>
                    <block wx:if="{{lastPageType!=1&&signRandomNumber==2}}">
                        <view wx:if="{{signRandomNumber2==0}}">每一天的努力，都将收获生命的意义</view>
                        <view wx:if="{{signRandomNumber2==1}}">拥有梦想的人，不做选择题，他们只做证明题。</view>
                        <view wx:if="{{signRandomNumber2==2}}">ヾ(@^▽^@)ノ</view>
                        <view wx:if="{{signRandomNumber2==3}}">(๑•̀ㅂ•́)و✧</view>
                        <view wx:if="{{signRandomNumber2==4}}">{{' '}}{{'(o゜▽゜)o☆[BINGO!]'}}</view>
                        <view wx:if="{{signRandomNumber2==5}}">{{' '}}{{'ヾ(≧∇≦*)ゝ'}}{{' '}}</view>
                        <view wx:if="{{signRandomNumber2==6}}">(o゜▽゜)o☆</view>
                    </block>
                </block>
                <text wx:if="{{otherFlag}}">提交成功！</text>
            </view>
            <view bindtap="editAgain" class="journal_box" wx:if="{{lastPageType==1}}">再来一篇</view>
        </view>
        <view bindtap="toposDetail" class="recommendItem" data-item="{{postInfo}}" wx:if="{{postSize>0}}">
            <view class="recommendItemTop">
                <view class="recommendItemTop_title">职位推荐</view>
                <view bindtap="toQiuzhi" class="recommendItemTop_r" data-e-tap-so="this" wx:if="{{postSize>=2}}">查看更多<text class="icon icon-jiantou"></text>
                </view>
            </view>
            <view bindtap="toposDetail" class="item_info" data-item="{{postInfoItem[$original]}}" wx:for="{{loopArray1261}}" wx:for-item="postInfoItem" wx:key="index">
                <view class="iteminfo_top">
                    <view class="iteminfo_top_name">{{postInfoItem[$original].name}}</view>
                    <view class="iteminfo_top_tag" wx:if="{{postInfoItem[$original].entDealRate>70}}">
                        <view class="doc"></view>响应积极</view>
                    <view class="iteminfo_top_tag1" wx:if="{{postInfoItem[$original].publishNewFlag===1}}">最近更新</view>
                    <view class="nature_text" wx:if="{{postInfoItem[$original].nature=='兼职'}}">兼职</view>
                    <view class="iteminfo_top_money">
                        <text wx:if="{{postInfoItem[$original].salaryType==0}}">
                            <text wx:if="{{!postInfoItem[$original].floorSalary&&!postInfoItem[$original].upperSalary}}">面谈</text>
                            <text wx:if="{{postInfoItem[$original].floorSalary||postInfoItem[$original].upperSalary}}">{{(postInfoItem[$original].floorSalary||0)+'-'+(postInfoItem[$original].upperSalary||0)+'/月'}}</text>
                        </text>
                        <text class="salary" wx:if="{{postInfoItem[$original].salaryType==2}}">
                            <text wx:if="{{!postInfoItem[$original].upperSalary}}">面谈</text>
                            <text wx:if="{{postInfoItem[$original].upperSalary}}">{{postInfoItem[$original].upperSalary+'/月'}}</text>
                        </text>
                        <text wx:if="{{postInfoItem[$original].salaryType==1}}">
                            <text wx:if="{{!postInfoItem[$original].daySalary}}">面谈</text>
                            <text wx:if="{{postInfoItem[$original].miniDaySalary===null&&postInfoItem[$original].daySalary}}">{{postInfoItem[$original].daySalary+'元/天'}}</text>
                            <text wx:if="{{postInfoItem[$original].miniDaySalary!==null&&postInfoItem[$original].daySalary}}">{{(postInfoItem[$original].miniDaySalary||0)+'-'+(postInfoItem[$original].daySalary||0)+'元/天'}}</text>
                        </text>
                        <text class="salary" wx:if="{{postInfoItem[$original].salaryType==3}}">
                            <text wx:if="{{!postInfoItem[$original].daySalary}}">面谈</text>
                            <text wx:if="{{postInfoItem[$original].daySalary}}">{{postInfoItem[$original].daySalary+'元/天'}}</text>
                        </text>
                        <text class="salary" wx:if="{{postInfoItem[$original].salaryType==4}}">面谈</text>
                    </view>
                </view>
                <view class="iteminfo_tag">
                    <view class="iteminfo_tag_item" wx:for="{{postInfoItem[$anonymousCallee__162]}}" wx:for-index="_anonIdx2" wx:for-item="welfare" wx:key="welfare">{{welfare}}</view>
                    <view class="iteminfo_tag_item" wx:if="{{postInfoItem[$original].welfareLabels.length>4}}">...</view>
                </view>
                <view class="itembottom">
                    <image class="itembottom_head" src="{{postInfoItem[$original].logoUrl}}" wx:if="{{postInfoItem[$original].logoUrl}}"></image>
                    <image class="itembottom_head" src="data:image/png;base64," wx:if="{{!postInfoItem[$original].logoUrl}}"></image>
                    <view class="itembottom_name">{{postInfoItem[$original].enterpriseName}}</view>
                    <view class="itembottom_hy">{{postInfoItem[$original].industry}}</view>
                    <view class="itembottom_line"></view>
                    <view class="itembottom_num">{{postInfoItem[$original].scale}}</view>
                    <view class="itembottom_addr">{{postInfoItem[$original].location||''}}</view>
                </view>
            </view>
        </view>
        <view bindtap="anonymousFunc0" class="perfect_information" wx:if="{{!jobHunt}}">
            <text class="perfect_information1">完善的求职意向有助于更精确推荐职位哦！</text>
            <text class="perfect_information2">去完善 →</text>
        </view>
        <view bindtap="backCallback" class="determine" data-e-tap-so="this" wx:if="{{postSize!=0&&!jobHunt}}">确定</view>
        <view bindtap="backCallback" class="{{['determine',postSize==0&&'determine_top']}}" data-e-tap-so="this" wx:if="{{postSize==0||postSize!=0&&jobHunt}}">确定<text class="determine_miao" wx:if="{{countDownTime!=0}}">（{{countDownTime}}s）</text>
        </view>
    </view>
</van-popup>
