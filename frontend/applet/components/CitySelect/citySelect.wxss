.actionradio_warp {
    height: calc(100vh - 400rpx);
    width: 100%
}

.title {
    -webkit-box-sizing: border-box;
    box-sizing: border-box;
    color: #666;
    font-size: 34rpx;
    font-weight: 500;
    line-height: 92rpx;
    padding: 4rpx 32rpx 0;
    width: 100%
}

.title .closeIcon {
    background: url(https://xcxstatic.xybsyw.com/xcx/images/blogOptimize202103_10.png) 50% no-repeat;
    background-size: 30rpx 30rpx;
    float: right;
    height: 30rpx;
    left: 10rpx;
    padding: 20rpx;
    position: relative;
    width: 30rpx
}

.click_hover {
    background: #f5f5f5
}

.container {
    border-top: 1rpx solid #e5e5e5;
    width: 100%
}

.childrenWarp {
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    width: 100%
}

.firstWarp,.firstWarp .item,.secondWarp {
    -webkit-box-sizing: border-box;
    box-sizing: border-box
}

.firstWarp {
    background: #fafafa;
    padding: 28rpx 0;
    width: 290rpx
}

.firstWarp .item,.secondWarp {
    position: relative
}

.firstWarp .item {
    height: 96rpx;
    line-height: 96rpx;
    overflow: hidden;
    padding: 0 32rpx;
    -o-text-overflow: ellipsis;
    text-overflow: ellipsis;
    white-space: nowrap
}

.firstWarp .current {
    color: #ff453a
}

.secondWarp {
    background: #fff;
    -webkit-flex: 1;
    -ms-flex: 1;
    flex: 1;
    padding: 28rpx 0
}

.loading-warp {
    background-color: hsla(0,0%,100%,.3);
    bottom: 0;
    left: 0;
    position: absolute;
    right: 0;
    top: 0;
    z-index: 100
}

.secondWarp .item,.secondWarp .item .checkIcon {
    -webkit-box-sizing: border-box;
    box-sizing: border-box
}

.secondWarp .item {
    height: 96rpx;
    line-height: 96rpx;
    overflow: hidden;
    padding: 0 74rpx 0 32rpx;
    position: relative
}

.secondWarp .item .checkIcon {
    display: inline-block;
    height: 36rpx;
    position: absolute;
    right: 40rpx;
    top: 50%;
    -webkit-transform: translateY(-50%);
    -ms-transform: translateY(-50%);
    transform: translateY(-50%);
    width: 36rpx
}

.weixuan {
    border: 1rpx solid #c9c9c9;
    border-radius: 4rpx
}

.yixuanzhong {
    vertical-align: middle
}

.footer {
    background: #fff;
    bottom: 0;
    left: 0;
    position: fixed;
    width: 100%
}

.bottom_iphonex {
    padding-bottom: 48rpx
}

.btn_warp {
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    font-size: 32rpx;
    height: 88rpx;
    padding: 0 24rpx;
    width: 100%
}

.btn_warp .reset,.btn_warp .sure {
    border-radius: 8rpx;
    text-align: center
}

.btn_warp,.btn_warp .reset {
    -webkit-box-sizing: border-box;
    box-sizing: border-box
}

.btn_warp .reset {
    background: #ffe0de;
    color: #ff453a;
    height: 100%;
    line-height: 86rpx;
    margin-right: 22rpx;
    width: 340rpx
}

.btn_warp .sure {
    background: -webkit-linear-gradient(295deg,#ff6a5c,#ff463c);
    background: -o-linear-gradient(295deg,#ff6a5c 0,#ff463c 100%);
    background: linear-gradient(155deg,#ff6a5c,#ff463c);
    color: #fff;
    -webkit-flex: 1;
    -ms-flex: 1;
    flex: 1;
    line-height: 88rpx
}

.footer .hasSelect {
    -webkit-box-shadow: 0 -2rpx 12rpx 0 rgba(0,0,0,.1);
    box-shadow: 0 -2rpx 12rpx 0 rgba(0,0,0,.1);
    -webkit-box-sizing: border-box;
    box-sizing: border-box;
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    line-height: 40rpx;
    padding: 40rpx 32rpx 0;
    width: 100%
}

.footer .hasSelect .left {
    color: #999;
    padding-bottom: 24rpx
}

.hasSelect .right {
    -webkit-flex: 1;
    -ms-flex: 1;
    flex: 1
}

.hasSelect .right .tag,.hasSelect .right .tag .at-icon {
    -ms-flex-align: center;
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex
}

.hasSelect .right .tag {
    background: #f5f5f5;
    border-radius: 20rpx;
    color: #666;
    float: left;
    font-size: 22rpx;
    height: 40rpx;
    line-height: 40rpx;
    margin-bottom: 24rpx;
    margin-left: 24rpx;
    padding: 0 16rpx
}

.hasSelect .right .tag .at-icon {
    -ms-flex-pack: center;
    color: #9f9f9f;
    font-size: 16rpx;
    -webkit-justify-content: center;
    justify-content: center;
    margin-left: 6rpx
}

.position-item {
    color: #4b82e4
}

.position-item .icon {
    font-size: 28rpx
}
