.Popup_layout {
    height: 100%;
    left: 0;
    position: fixed;
    top: 0;
    -webkit-transition: visibility 3s cubic-bezier(.36,.66,.04,1);
    -o-transition: visibility 3s cubic-bezier(.36,.66,.04,1);
    transition: visibility 3s cubic-bezier(.36,.66,.04,1);
    visibility: hidden;
    width: 100%;
    z-index: 8100111
}

.Popup_layout.active {
    visibility: visible;
    z-index: 8100111
}

.Popup_layout.active .Popup_layout__overlay {
    opacity: 1
}

.Popup_layout.active .Popup_layout__container {
    -webkit-transform: translate3d(0,0,0);
    transform: translate3d(0,0,0)
}

.zfy {
    z-index: -1
}

.Popup_layout__overlay {
    background-color: rgba(0,0,0,.3);
    height: 100%;
    left: 0;
    opacity: 0;
    position: absolute;
    top: 0;
    -webkit-transition: opacity .15s ease-in;
    -o-transition: opacity .15s ease-in;
    transition: opacity .15s ease-in;
    width: 100%
}

.Popup_layout__container {
    border-radius: 32rpx 32rpx 0 0;
    bottom: 0;
    position: absolute;
    -webkit-transition: -webkit-transform .3s cubic-bezier(.36,.66,.04,1);
    -o-transition: transform .3s cubic-bezier(.36,.66,.04,1);
    transition: -webkit-transform .3s cubic-bezier(.36,.66,.04,1);
    transition: transform .3s cubic-bezier(.36,.66,.04,1);
    transition: transform .3s cubic-bezier(.36,.66,.04,1),-webkit-transform .3s cubic-bezier(.36,.66,.04,1);
    width: 100%
}

.Popup_layout .layout-header {
    background: #f9fafc;
    border-radius: 28rpx 28rpx 0 0;
    -webkit-box-sizing: border-box;
    box-sizing: border-box;
    color: #333;
    font-size: 32rpx;
    font-weight: 600;
    height: 96rpx;
    line-height: 96rpx;
    padding-left: 34rpx;
    position: relative;
    text-align: center;
    width: 100%
}

.Popup_layout .layout-header .close-img {
    height: 36rpx;
    position: absolute;
    right: 28rpx;
    top: 36rpx;
    width: 36rpx
}

.Popup_layout__container,.hide_d {
    -webkit-transform: translate3d(0,100%,0);
    transform: translate3d(0,100%,0)
}

.popup-close-icon {
    -ms-flex-align: center;
    -ms-flex-pack: center;
    -webkit-align-items: center;
    align-items: center;
    color: rgba(0,0,0,.54);
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    font-size: 28rpx;
    font-weight: 500;
    height: 51rpx;
    -webkit-justify-content: center;
    justify-content: center;
    position: absolute;
    right: 19rpx;
    top: 26rpx;
    width: 51rpx;
    z-index: 101
}
