.completeness_box {
    -ms-flex-pack: center;
    -ms-flex-align: center;
    -webkit-align-items: center;
    align-items: center;
    background: #fcefee;
    border-radius: 16rpx;
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    height: 124rpx;
    -webkit-justify-content: center;
    justify-content: center;
    padding: 0 20rpx
}

.completeness_box wx-image {
    height: 70rpx;
    margin-right: 20rpx;
    width: 70rpx
}

.completeness_box .text_context {
    -webkit-flex: 1;
    -ms-flex: 1;
    flex: 1
}

.completeness_box .text_context .text1 {
    color: #282828;
    font-size: 24rpx;
    font-weight: 700
}

.completeness_box .text_context .text1.is-small {
    font-size: 22rpx
}

.completeness_box .text_context .text2 {
    color: #999;
    font-size: 22rpx;
    font-weight: 400
}

.completeness_box .btn_box {
    background: #ed6863;
    border-radius: 23rpx;
    color: #fff;
    font-size: 24rpx;
    font-weight: 400;
    height: 45rpx;
    line-height: 45rpx;
    text-align: center;
    width: 96rpx
}

.is-fixed {
    background: #fcefee;
    border: 1rpx solid #f25451;
    border-radius: 100rpx;
    -webkit-box-shadow: 0 -2rpx 16rpx 0 rgba(247,37,37,.2);
    box-shadow: 0 -2rpx 16rpx 0 rgba(247,37,37,.2);
    -webkit-box-sizing: border-box;
    box-sizing: border-box;
    left: 16rpx;
    position: fixed;
    width: calc(100vw - 32rpx);
    z-index: 1
}

.close-icon {
    -ms-flex-pack: center;
    -ms-flex-align: center;
    -webkit-align-items: center;
    align-items: center;
    background: #c2c2c2;
    border-radius: 50%;
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    height: 30rpx;
    -webkit-justify-content: center;
    justify-content: center;
    position: absolute;
    right: 0;
    top: -35rpx;
    width: 30rpx
}

.close-icon .icon {
    color: #fff;
    font-size: 16rpx
}
