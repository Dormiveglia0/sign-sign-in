@-webkit-keyframes wateranimate {
    0% {
        border: 1rpx transparent;
        -webkit-transform: scaleX(1) scaleY(1);
        transform: scaleX(1) scaleY(1)
    }

    5% {
        border: 1rpx solid rgba(255,69,58,.6)
    }

    to {
        border: 1rpx solid rgba(255,69,58,.6);
        opacity: 0;
        -webkit-transform: scaleX(1.2) scaleY(1.5);
        transform: scaleX(1.2) scaleY(1.5)
    }
}

@keyframes wateranimate {
    0% {
        border: 1rpx transparent;
        -webkit-transform: scaleX(1) scaleY(1);
        transform: scaleX(1) scaleY(1)
    }

    5% {
        border: 1rpx solid rgba(255,69,58,.6)
    }

    to {
        border: 1rpx solid rgba(255,69,58,.6);
        opacity: 0;
        -webkit-transform: scaleX(1.2) scaleY(1.5);
        transform: scaleX(1.2) scaleY(1.5)
    }
}

.live-bar {
    -ms-flex-align: center;
    -webkit-align-items: center;
    align-items: center;
    background: #fff;
    border: 2rpx solid rgba(255,69,58,.6);
    border-radius: 440rpx;
    bottom: 195rpx;
    -webkit-box-sizing: border-box;
    box-sizing: border-box;
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    height: 88rpx;
    left: 50%;
    min-width: 440rpx;
    padding: 10rpx;
    position: fixed;
    -webkit-transform: translateX(-50%);
    -ms-transform: translateX(-50%);
    transform: translateX(-50%)
}

.live-bar-water1,.live-bar-water2,.live-bar-water3,.live-bar-water4 {
    -webkit-animation: wateranimate 2.5s ease-out 2.5s infinite;
    animation: wateranimate 2.5s ease-out 2.5s infinite;
    border-radius: 44rpx;
    -webkit-box-sizing: border-box;
    box-sizing: border-box;
    height: 100%;
    left: 0;
    position: absolute;
    top: 0;
    -webkit-transform: scale(1.2);
    -ms-transform: scale(1.2);
    transform: scale(1.2);
    width: 100%
}

.live-bar-water2,.live-bar-water3,.live-bar-water4 {
    -webkit-animation: wateranimate 2.5s ease-out 1.66s infinite;
    animation: wateranimate 2.5s ease-out 1.66s infinite
}

.live-bar-water3,.live-bar-water4 {
    -webkit-animation: wateranimate 2.5s ease-out .83s infinite;
    animation: wateranimate 2.5s ease-out .83s infinite
}

.live-bar-water4 {
    -webkit-animation: wateranimate 2.5s ease-out 0s infinite;
    animation: wateranimate 2.5s ease-out 0s infinite
}

.live-icon {
    height: 70rpx;
    margin-right: 20rpx;
    width: 70rpx
}

.live-bar-text .title {
    color: #333;
    font-size: 24rpx;
    font-weight: 500;
    line-height: 33rpx;
    max-width: 12em
}

.live-bar-text .content {
    color: #999;
    font-size: 22rpx;
    font-weight: 400;
    line-height: 30rpx
}

.icon-guanbi {
    color: #dbdbdb;
    font-size: 20rpx;
    position: absolute;
    right: 20rpx;
    top: 50%;
    -webkit-transform: translateY(-50%);
    -ms-transform: translateY(-50%);
    transform: translateY(-50%)
}
