.container {
    background-color: rgba(51,51,51,.8);
    bottom: 0;
    left: 0;
    overflow: hidden;
    position: fixed;
    right: 0;
    top: 0;
    z-index: 111111
}

.container,.page-page {
    height: 100%;
    width: 100%
}

.page-page {
    position: relative
}

.animation-element,.gold {
    height: 434rpx;
    left: 50%;
    margin-left: -216rpx;
    margin-top: -217rpx;
    position: absolute;
    top: 50%;
    width: 435rpx
}

.gold {
    height: 767rpx;
    margin-left: -50%;
    margin-top: -367rpx;
    width: 734rpx;
    z-index: 1
}

.gold1 {
    height: 601rpx;
    top: 260rpx;
    -webkit-transform: translateX(-50%);
    -ms-transform: translateX(-50%);
    transform: translateX(-50%);
    width: 100%;
    z-index: 1
}

.feng,.gold1,.pointMall {
    left: 50%;
    position: absolute
}

.pointMall {
    height: 585rpx;
    top: 256rpx;
    -webkit-transform: translateX(-50%);
    -ms-transform: translateX(-50%);
    transform: translateX(-50%);
    width: 100%;
    z-index: 1
}

.feng {
    height: 44rpx;
    margin-left: -64rpx;
    margin-top: -22rpx;
    top: 70%;
    width: 127rpx
}
