.actionradio_warp,.menuwarp,.selectWarp {
    width: 100%
}

.menuwarp {
    background: #fff;
    border-bottom: 1rpx solid #dbdbdb;
    -webkit-box-sizing: border-box;
    box-sizing: border-box;
    height: 88rpx;
    padding: 0 10rpx;
    position: relative
}

.menuwarp .menu {
    color: #666;
    float: left;
    font-size: 32rpx;
    line-height: 87rpx;
    max-width: 200rpx;
    overflow: hidden;
    padding: 0 24rpx;
    position: relative;
    text-align: center;
    -o-text-overflow: ellipsis;
    text-overflow: ellipsis;
    -webkit-transition: all .3s ease-in-out;
    -o-transition: all .3s ease-in-out;
    transition: all .3s ease-in-out;
    white-space: nowrap
}

.menuwarp .menu .line {
    background: #ff453a;
    border-radius: 6rpx;
    bottom: -1rpx;
    display: none;
    height: 6rpx;
    left: 50%;
    position: absolute;
    -webkit-transform: translateX(-50%);
    -ms-transform: translateX(-50%);
    transform: translateX(-50%);
    width: 40rpx;
    z-index: 99
}

.menuwarp .active {
    color: #ff453a;
    font-weight: 600
}

.menuwarp .active .line {
    display: block
}

.contentWarp,.optionwarp .item {
    -webkit-box-sizing: border-box;
