.title_warp {
    background: #f9fafc;
    border-radius: 28rpx 28rpx 0 0;
    -webkit-box-sizing: border-box;
    box-sizing: border-box;
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    height: 88rpx;
    padding: 22rpx 32rpx 0
}

.title_warp .l_warp,.title_warp .m_warp,.title_warp .r_warp {
    color: #666;
    font-size: 32rpx;
    font-weight: 400;
    height: 45rpx;
    line-height: 45rpx
}

.title_warp .m_warp,.title_warp .r_warp {
    color: #1e82d2
}

.title_warp .m_warp {
    color: #333;
    -webkit-flex: 1;
    -ms-flex: 1;
    flex: 1;
    font-weight: 600;
    text-align: center
}
