@-webkit-keyframes emoji-move-in {
    0% {
        margin-bottom: -400rpx
    }

    to {
        margin-bottom: 0
    }
}

@keyframes emoji-move-in {
    0% {
        margin-bottom: -400rpx
    }

    to {
        margin-bottom: 0
    }
}

@-webkit-keyframes emoji-move-out {
    0% {
        margin-bottom: 0
    }

    to {
        margin-bottom: -400rpx
    }
}

@keyframes emoji-move-out {
    0% {
        margin-bottom: 0
    }

    to {
        margin-bottom: -400rpx
    }
}

@-webkit-keyframes pd-left-move {
    0% {
        padding-left: 10rpx
    }

    to {
        padding-left: 30rpx
    }
}

@keyframes pd-left-move {
    0% {
        padding-left: 10rpx
    }

    to {
        padding-left: 30rpx
    }
}

.WxEmojiViewContainer {
    bottom: 0;
    left: 0;
    position: fixed;
    width: 100%;
    z-index: 1
}

.handle_bottom {
    -ms-flex-pack: justify;
    -ms-flex-line-pack: center;
    -ms-flex-align: center;
    -webkit-align-content: center;
    align-content: center;
    -webkit-align-items: center;
    align-items: center;
    background: #fff;
    border-bottom: 1rpx solid #e5e5e5;
    border-top: 1rpx solid #e5e5e5;
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    height: 90rpx;
    -webkit-justify-content: space-between;
    justify-content: space-between;
    width: 100%;
    z-index: 100
}

.handle_bottom_iphonex {
    height: 138rpx;
    padding-bottom: 48rpx
}

.insert_image,.keyboard {
    margin-left: 32rpx
}

.insert_image wx-image {
    height: 60rpx;
    width: 72rpx
}

.button1,.insert_image .keyboard {
    height: 60rpx;
    width: 64rpx
}

.button1 {
    background: #ff453a;
    border-radius: 8rpx;
    color: #fff;
    font-family: PingFangSC-Regular;
    font-size: 28rpx;
    font-weight: 400;
    line-height: 60rpx;
    margin-left: 40rpx;
    margin-right: 32rpx;
    text-align: center;
    width: 128rpx
}

.swiperContainer {
    background: #fff;
    height: 412rpx;
    width: 100%
}

.emoji,.emoji-box {
    -webkit-box-sizing: border-box;
    box-sizing: border-box
}

.emoji {
    background-color: #fff;
    font-size: 20rpx;
    height: 60rpx;
    padding-top: 2rpx;
    text-align: center;
    width: 60rpx
}

.emoji-box {
    background: #fff;
    height: 338rpx;
    margin-bottom: -400rpx;
    padding: 25rpx 30rpx 5rpx 46rpx;
    position: relative
}

.emoji-cell {
    display: inline-block;
    height: 82rpx;
    width: 14.28%
}

.emoji-cell wx-image {
    border-radius: 3rpx;
    height: 66rpx;
    padding: 0;
    width: 66rpx
}

.emoji-move-in {
    -webkit-animation: emoji-move-in .3s forwards;
    animation: emoji-move-in .3s forwards
}

.emoji-move-out {
    -webkit-animation: emoji-move-out .3s forwards;
    animation: emoji-move-out .3s forwards
}

.no-emoji-move {
    -webkit-animation: none;
    animation: none
}

.touch-active-0 {
    bottom: 106rpx;
    height: 40rpx;
    position: fixed;
    right: 62rpx;
    width: 58rpx
}
