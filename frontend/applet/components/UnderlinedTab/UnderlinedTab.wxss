.tab-container {
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    height: 108rpx
}

.tab-item {
    color: #333;
    font-size: 32rpx;
    font-weight: 400;
    line-height: 108rpx;
    margin-right: 48rpx;
    position: relative
}

.tab-item-active {
    font-weight: 600
}

.tab-item-active::after {
    background: url(https://xcxstatic.xybsyw.com/xcx/images/tab_on.png) 0 0 no-repeat;
    background-size: cover!important;
    bottom: 10rpx;
    content: "";
    height: 12rpx;
    left: 50%;
    position: absolute;
    -webkit-transform: translateX(-50%);
    -ms-transform: translateX(-50%);
    transform: translateX(-50%);
    width: 34rpx
}
