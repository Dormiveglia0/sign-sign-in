.popup-container {
    background: #fff;
    border-radius: 28rpx 28rpx 0 0;
    padding-bottom: 60rpx;
    padding-right: 16rpx;
    position: relative
}

.popup-container .iconguanbi {
    -ms-flex-align: center;
    -ms-flex-pack: center;
    -webkit-align-items: center;
    align-items: center;
    color: rgba(0,0,0,.54);
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    font-size: 26rpx;
    height: 57rpx;
    -webkit-justify-content: center;
    justify-content: center;
    position: absolute;
    right: 32rpx;
    top: 32rpx;
    width: 57rpx
}

.popup-title {
    color: #333;
    font-size: 34rpx;
    font-weight: 600;
    line-height: 48rpx;
    padding-left: 40rpx;
    padding-top: 37rpx
}

.popup-title .tips {
    color: #999;
    font-size: 24rpx;
    line-height: 33rpx;
    margin-left: 8rpx
}

.advisor-list {
    height: 665rpx;
    overflow-y: auto;
    padding-left: 50rpx
}

.advisor-item {
    margin-top: 40rpx
}

.advisor-item .advisor-name {
    color: #333;
    font-size: 30rpx;
    font-weight: 400;
    line-height: 42rpx
}

.advisor-item .advisor-faculty {
    color: #999;
    display: inline-block;
    font-size: 26rpx;
    font-weight: 400;
    line-height: 37rpx;
    margin-left: 20rpx;
    max-width: 15em;
    vertical-align: text-top
}

.icon-guanbi {
    -ms-flex-align: center;
    -ms-flex-pack: center;
    -webkit-align-items: center;
    align-items: center;
    color: rgba(0,0,0,.4);
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    font-size: 30rpx;
    font-weight: 600;
    height: 50rpx;
    -webkit-justify-content: center;
    justify-content: center;
    position: absolute;
    right: 25rpx;
    top: 30rpx;
    width: 50rpx;
    z-index: 100
}
