.upload-image-container {
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    -webkit-flex-wrap: wrap;
    -ms-flex-wrap: wrap;
    flex-wrap: wrap
}

.upload-image-container.has-padding {
    padding: 0 32rpx 40rpx 48rpx
}

.upload-image-container .image-item {
    border-radius: 13rpx;
    height: 148rpx;
    margin-bottom: 24rpx;
    margin-right: 24rpx;
    position: relative;
    width: 201rpx
}

.upload-image-container .image-item:nth-child(3n) {
    margin-right: 0
}

.upload-image-container .image-item .img_pic2 {
    -ms-flex-align: center;
    -ms-flex-pack: center;
    -webkit-align-items: center;
    align-items: center;
    border-radius: 16rpx;
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    -webkit-flex-direction: column;
    -ms-flex-direction: column;
    flex-direction: column;
    height: 148rpx;
    -webkit-justify-content: center;
    justify-content: center;
    width: 200rpx
}

.upload-image-container .image-item .img_pic2 .image-item__text {
    color: #999;
    font-size: 24rpx;
    line-height: 33rpx;
    margin-top: 14rpx
}

.upload-image-container .image-item .pic2 {
    height: 48rpx;
    width: 64rpx
}

.upload-image-container .image-item .pic {
    border-radius: 13rpx;
    height: 100%;
    width: 100%
}

.upload-image-container .delete {
    height: 33rpx;
    position: absolute;
    right: 0;
    top: 0;
    -webkit-transform: translate(50%,-50%);
    -ms-transform: translate(50%,-50%);
    transform: translate(50%,-50%);
    width: 33rpx
}

.upload-image-container .upload-item {
    background-color: #f5f5f5;
    border-radius: 13rpx
}
