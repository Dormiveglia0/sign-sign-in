.company_top {
    background: #fff;
    -webkit-box-sizing: border-box;
    box-sizing: border-box;
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    margin-bottom: 16rpx;
    padding: 32rpx 32rpx 0;
    width: 100%
}

.border_radius_28 {
    border-radius: 28rpx
}

.company_top .left {
    border: 1rpx solid #e5e5e5;
    border-radius: 4rpx;
    height: 96rpx;
    margin-right: 24rpx;
    overflow: hidden;
    width: 96rpx
}

.company_top .left wx-image {
    height: 100%;
    width: 100%
}

.company_top .right {
    -webkit-flex: 1;
    -ms-flex: 1;
    flex: 1;
    padding-bottom: 32rpx
}

.company_top .right .name {
    color: #000;
    font-size: 32rpx;
    line-height: 45rpx;
    margin-bottom: 8rpx
}

.company_top .right .info {
    color: #666;
    font-size: 22rpx;
    line-height: 30rpx;
    margin-bottom: 8rpx
}

.company_top .right .hotwantedLayout {
    -webkit-box-sizing: border-box;
    box-sizing: border-box;
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    -webkit-flex-direction: row;
    -ms-flex-direction: row;
    flex-direction: row
}

.company_top .right .hotwanted {
    border: 1rpx solid #e0e0e0;
    border-radius: 22rpx;
    color: #666;
    font-size: 22rpx;
    height: 40rpx;
    line-height: 40rpx;
    margin-top: 16rpx;
    padding: 0 16rpx
}

.company_top .right .hotwanted wx-text {
    color: #ff453a
}

.company_top .right .detailLocation {
    color: #c1c1c1;
    font-size: 22rpx;
    line-height: 30rpx;
    min-height: 30rpx
}
