.share_box {
    background-color: #fff;
    border-radius: 28rpx 28rpx 0 0;
    height: 485rpx
}

.share_box .title {
    -ms-flex-pack: justify;
    -ms-flex-align: center;
    -webkit-align-items: center;
    align-items: center;
    -webkit-justify-content: space-between;
    justify-content: space-between;
    padding: 22rpx 32rpx 0 40rpx
}

.share_box .title .name {
    color: #333;
    font-size: 32rpx;
    line-height: 32rpx
}

.share_box .title .icon {
    color: rgba(0,0,0,.54);
    font-size: 36rpx
}

.likeXYB,.share_box .share_btns,.share_box .title {
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex
}

.share_box .share_btns {
    -ms-flex-pack: center;
    -webkit-justify-content: center;
    justify-content: center;
    padding: 103rpx 0 0
}

.share_box .share_item {
    background: 0 0;
    margin: 0;
    padding: 0;
    width: 98rpx
}

.share_box .share_item wx-image {
    height: 98rpx;
    width: 98rpx
}

.share_box .share_item .text {
    clear: both;
    color: #6c6d73;
    font-size: 24rpx;
    line-height: 33rpx;
    padding-top: 16rpx;
    text-align: center
}

.share_box .mgl {
    margin-left: 178rpx!important
}

.likeXYB {
    -ms-flex-align: start;
    -ms-flex-pack: justify;
    -webkit-align-items: flex-start;
    align-items: flex-start;
    background-image: url(https://xcxstatic.xybsyw.com/xcx/images/tip_collect_wx.png);
    background-repeat: no-repeat;
    background-size: 564rpx 128rpx!important;
    -webkit-box-sizing: border-box;
    box-sizing: border-box;
    color: #fff;
    font-size: 26rpx;
    font-weight: 500;
    height: 128rpx;
    -webkit-justify-content: space-between;
    justify-content: space-between;
    line-height: 40rpx;
    padding-left: 24rpx;
    padding-right: 38rpx;
    padding-top: 37rpx;
    position: fixed;
    right: 92rpx;
    width: 564rpx;
    z-index: 299999
}

.likeXYB>wx-view {
    width: 443rpx
}

.likeXYB .icon-guanbi {
    font-size: 20rpx;
    font-weight: 600
}
