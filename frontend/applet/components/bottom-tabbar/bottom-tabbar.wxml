<block wx:if="{{$taroCompReady}}">
    <view catchtap="anonymousFunc0" class="{{'bottom_bar '+(ifIphoneX?'bottom_on':'')}}" id="bottom_bar" wx:if="{{showBottom}}">
        <view catchtap="anonymousFunc1" class="bar_item" wx:if="{{anonymousState__temp}}">
            <image binderror="{{true}}" bindload="{{true}}" class="image1" lazyLoad="false" mode="aspectFit|aspectFill|widthFix" src="https://xcxstatic.xybsyw.com/xcx/images/menubar_school_v2.png" wx:if="{{barFlag!=1}}"></image>
            <image binderror="{{true}}" bindload="{{true}}" class="image1" lazyLoad="false" mode="aspectFit|aspectFill|widthFix" src="https://xcxstatic.xybsyw.com/xcx/images/menubar_school_v2-active.png" wx:if="{{barFlag==1}}"></image>
            <view class="{{'bar_title bar_title_'+(barFlag==1?'active':'')}}">机会</view>
        </view>
        <view catchtap="anonymousFunc2" class="bar_item" wx:if="{{showFlag}}">
            <image binderror="{{true}}" bindload="{{true}}" class="image2" lazyLoad="false" mode="aspectFit|aspectFill|widthFix" src="https://xcxstatic.xybsyw.com/xcx/images/menubar_growup_v2.png" wx:if="{{barFlag!=2}}"></image>
            <image binderror="{{true}}" bindload="{{true}}" class="image2" lazyLoad="false" mode="aspectFit|aspectFill|widthFix" src="https://xcxstatic.xybsyw.com/xcx/images/menubar_growup_v2-active.png" wx:if="{{barFlag==2}}"></image>
            <view class="message_growup" wx:if="{{showGrowUp}}"></view>
            <view class="{{'bar_title bar_title_'+(barFlag==2?'active':'')}}">{{schoolId=='13319'?'实习':'实习成长'}}</view>
        </view>
        <view catchtap="anonymousFunc3" class="bar_item" wx:if="{{schoolId!='13319'}}">
            <image binderror="{{true}}" bindload="{{true}}" class="image4" lazyLoad="false" mode="aspectFit|aspectFill|widthFix" src="https://xcxstatic.xybsyw.com/xcx/images/menubar_message_v2.png" wx:if="{{barFlag!=4}}"></image>
            <image binderror="{{true}}" bindload="{{true}}" class="image4" lazyLoad="false" mode="aspectFit|aspectFill|widthFix" src="https://xcxstatic.xybsyw.com/xcx/images/menubar_message_v2-active.png" wx:if="{{barFlag==4}}"></image>
            <view class="{{msgAccount>99?'message_account_99':'message_account'}}" hoverClass="none" hoverStopPropagation="false" wx:if="{{msgAccount>0}}">{{msgAccount>99?'99+':msgAccount}}</view>
            <msg-dot compid="{{$compid__2704}}"></msg-dot>
            <view class="{{'bar_title bar_title_'+(barFlag==4?'active':'')}}">消息</view>
        </view>
        <view catchtap="anonymousFunc4" class="bar_item">
            <image binderror="{{true}}" bindload="{{true}}" class="image5" lazyLoad="false" mode="aspectFit|aspectFill|widthFix" src="https://xcxstatic.xybsyw.com/xcx/images/menubar_mine_v2.png" wx:if="{{barFlag!=5}}"></image>
            <image binderror="{{true}}" bindload="{{true}}" class="image5" lazyLoad="false" mode="aspectFit|aspectFill|widthFix" src="https://xcxstatic.xybsyw.com/xcx/images/menubar_mine_v2-active.png" wx:if="{{barFlag==5}}"></image>
            <view class="{{'bar_title bar_title_'+(barFlag==5?'active':'')}}">我的</view>
        </view>
    </view>
</block>
