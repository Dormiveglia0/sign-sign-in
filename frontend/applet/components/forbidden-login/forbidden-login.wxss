.forbiddenDialog {
    background-color: rgba(0,0,0,.4);
    bottom: 0;
    left: 0;
    position: fixed;
    right: 0;
    top: 0;
    z-index: 1111
}

.forbiddenDialog .contentItem {
    background: #fff;
    border-radius: 28rpx;
    -webkit-box-sizing: border-box;
    box-sizing: border-box;
    left: 50%;
    padding: 52rpx 65rpx;
    position: absolute;
    text-align: center;
    top: 50%;
    -webkit-transform: translate(-50%,-50%);
    -ms-transform: translate(-50%,-50%);
    transform: translate(-50%,-50%);
    width: 570rpx
}

.contentItem .text1 {
    color: #000;
    font-size: 36rpx;
    font-weight: 400;
    line-height: 50rpx;
    margin: 10rpx auto 0;
    text-align: center
}

.contentItem .text2 {
    color: #333;
    font-size: 26rpx;
    font-weight: 400;
    line-height: 37rpx;
    margin: 18rpx auto 0;
    text-align: left
}

.contentItem .closeButton {
    background: -webkit-linear-gradient(295deg,#ff6a5c,#ff463c);
    background: -o-linear-gradient(295deg,#ff6a5c 0,#ff463c 100%);
    background: linear-gradient(155deg,#ff6a5c,#ff463c);
    border-radius: 40rpx;
    color: #fff;
    font-size: 32rpx;
    font-weight: 400;
    height: 80rpx;
    line-height: 80rpx;
    margin: 48rpx auto 0;
    text-align: center;
    width: 360rpx
}

.contentItem .forbiddenLogin {
    height: 106rpx;
    margin: 0 auto;
    width: 101rpx
}
