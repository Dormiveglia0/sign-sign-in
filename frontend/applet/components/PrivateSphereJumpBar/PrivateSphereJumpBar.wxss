.top_jump {
    background: #edf4ff;
    -webkit-box-sizing: border-box;
    box-sizing: border-box;
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    height: 146rpx;
    padding: 20rpx 32rpx
}

.top_jump .img_icon {
    background: #c8e3ff;
    background: url(https://xcxstatic.xybsyw.com/teacherXcx/images/privateSphere_3.png) 0 0 no-repeat;
    background-size: contain;
    border-radius: 200rpx;
    height: 106rpx;
    width: 106rpx
}

.top_jump .text {
    color: #31356d;
    -webkit-flex: 1;
    -ms-flex: 1;
    flex: 1;
    font-size: 26rpx;
    height: 80rpx;
    line-height: 40rpx;
    overflow: hidden;
    padding-left: 20rpx;
    padding-right: 20rpx;
    padding-top: 13rpx
}

.top_jump .right_btn {
    background-color: #fff;
    border: 1rpx solid #fe493f;
    border-radius: 28rpx;
    color: #ff6a5c;
    font-size: 26rpx;
    font-weight: 600;
    height: 56rpx;
    line-height: 56rpx;
    margin-top: 25rpx;
    text-align: center;
    width: 126rpx
}
