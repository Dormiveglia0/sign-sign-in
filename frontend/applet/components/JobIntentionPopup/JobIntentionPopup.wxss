.popup-container {
    background: #fff;
    border-radius: 28rpx 28rpx 0 0;
    -webkit-box-sizing: border-box;
    box-sizing: border-box;
    height: -webkit-fit-content;
    height: -moz-fit-content;
    height: fit-content;
    padding: 48rpx 40rpx;
    width: 100%
}

.list-title,.title {
    color: #282828;
    font-size: 32rpx;
    font-weight: 500;
    line-height: 45rpx;
    margin-bottom: 48rpx
}

.list-title {
    color: #333;
    font-size: 26rpx;
    line-height: 37rpx;
    margin-bottom: 24rpx
}

.list-container {
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    -webkit-flex-wrap: wrap;
    -ms-flex-wrap: wrap;
    flex-wrap: wrap;
    margin-bottom: 8rpx
}

.tag-item {
    background: #f5f5f5;
    border-radius: 28rpx;
    -webkit-box-sizing: border-box;
    box-sizing: border-box;
    color: #666;
    height: 56rpx;
    margin-bottom: 24rpx;
    margin-right: 20rpx;
    padding: 0 20rpx;
    width: -webkit-fit-content;
    width: -moz-fit-content;
    width: fit-content
}

.tag-item .icon-guanbi {
    color: #9f9f9f;
    font-size: 20rpx;
    left: 0;
    margin-left: 16rpx;
    position: relative;
    top: 0
}

.button-container,.tag-item {
    -ms-flex-pack: justify;
    -ms-flex-align: center;
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    -webkit-justify-content: space-between;
    justify-content: space-between
}

.button-container .button {
    height: 80rpx;
    line-height: 80rpx;
    text-align: center;
    width: 47%
}
