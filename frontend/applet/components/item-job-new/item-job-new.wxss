.post_box {
    background: #fff;
    border-radius: 16rpx;
    -webkit-box-sizing: border-box;
    box-sizing: border-box;
    margin-bottom: 16rpx;
    padding: 32rpx 24rpx;
    position: relative;
    width: 100%
}

.post_box .post_top,.post_box .post_top .post_name {
    -ms-flex-align: center;
    -webkit-align-items: center;
    align-items: center
}

.post_box .post_top {
    -ms-flex-pack: justify;
    -ms-flex-line-pack: center;
    -webkit-align-content: center;
    align-content: center;
    -webkit-justify-content: space-between;
    justify-content: space-between
}

.post_box .post_top .post_name {
    color: #333;
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    -webkit-flex: 1;
    -ms-flex: 1;
    flex: 1;
    font-size: 32rpx;
    font-weight: 500;
    line-height: 42rpx
}

.post_box .post_top .post_name>.post_name-text {
    max-width: 358rpx
}

.post_box .post_top .post_money {
    color: #ff4a40;
    font-size: 30rpx;
    font-weight: 500;
    line-height: 42rpx;
    margin-left: 40rpx;
    max-width: 230rpx
}

.post_box .post_bottom,.post_box .post_center,.post_box .post_top {
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex
}

.post_box .post_center {
    -ms-flex-pack: justify;
    -ms-flex-align: center;
    -ms-flex-line-pack: center;
    -webkit-align-content: center;
    align-content: center;
    -webkit-align-items: center;
    align-items: center;
    height: 38rpx;
    -webkit-justify-content: space-between;
    justify-content: space-between;
    margin-top: 20rpx
}

.post_box .post_center .post_welfare_box {
    -webkit-flex: 1;
    -ms-flex: 1;
    flex: 1
}

.post_box .post_center .post_welfare_box .post_welfare {
    background: #f6f7fa;
    border-radius: 4rpx;
    -webkit-box-sizing: border-box;
    box-sizing: border-box;
    color: #343940;
    display: inline-block;
    font-size: 22rpx;
    font-weight: 400;
    height: 38rpx;
    margin-right: 16rpx;
    max-width: 154rpx;
    padding: 5rpx 8rpx;
    vertical-align: bottom
}

.post_box .post_center .post_welfare_box .disNone {
    display: none
}

.post_box .post_bottom {
    margin-top: 32rpx
}

.post_box .post_bottom .post_icon,.post_box .post_bottom .post_icon wx-image {
    height: 72rpx;
    width: 72rpx
}

.post_box .post_bottom .post_content {
    -webkit-flex: 1;
    -ms-flex: 1;
    flex: 1;
    margin-left: 16rpx
}

.post_box .post_bottom .post_content .post_company,.post_box .post_bottom .post_content .post_text {
    -ms-flex-align: center;
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex
}

.post_box .post_bottom .post_content .post_company {
    color: #484848;
    font-size: 26rpx;
    line-height: 37rpx
}

.post_box .post_bottom .post_content .post_company>.enterprise-name {
    max-width: 312rpx
}

.post_box .post_bottom .post_content .post_text {
    -ms-flex-pack: justify;
    -ms-flex-line-pack: center;
    -webkit-align-content: center;
    align-content: center;
    color: #999;
    font-weight: 400;
    -webkit-justify-content: space-between;
    justify-content: space-between;
    line-height: 28rpx
}

.post_box .post_bottom .post_content .post_text .tag {
    color: #999;
    display: inline-block;
    font-size: 22rpx
}

.post_box .post_bottom .post_content .post_text .tag wx-text {
    margin: 0 8rpx
}

.post_box .post_text_right {
    font-size: 24rpx;
    position: absolute;
    right: 28rpx;
    top: 94rpx
}

.post_border {
    border: 2rpx solid #f5f5f5;
    margin-bottom: 24rpx
}

.enterprise-tag-new,.enterprise-tag-new-cn {
    display: inline-block;
    height: 37rpx;
    margin-left: 8rpx;
    position: relative;
    top: 0;
    width: 61rpx
}

.enterprise-tag-new-cn {
    width: 82rpx
}

.enterprise-tag-recently {
    background: #fffaf5;
    border-radius: 4rpx;
    -webkit-box-sizing: border-box;
    box-sizing: border-box;
    color: #fb9018;
    font-size: 20rpx;
    height: 32rpx;
    line-height: 32rpx;
    margin-left: 8rpx;
    padding: 0 16rpx;
    text-align: center
}
