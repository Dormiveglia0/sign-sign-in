.company-card {
    background: #fff;
    border-radius: 16rpx;
    -webkit-box-sizing: border-box;
    box-sizing: border-box;
    margin-bottom: 20rpx;
    padding: 28rpx 24rpx 32rpx;
    width: 100%
}

.company-card.border {
    border: 2rpx solid #ededed
}

.company-card-header {
    -ms-flex-align: center;
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex
}

.company-card-header-right,.company-right {
    -webkit-flex: 1;
    -ms-flex: 1;
    flex: 1
}

.company-right {
    min-width: 0
}

.company-name {
    color: #1f1f2c;
    font-size: 30rpx;
    font-weight: 500;
    line-height: 42rpx;
    margin-bottom: 10rpx;
    margin-top: 6rpx
}

.company-info {
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex
}

.company-info-item {
    color: #a8a9b3;
    font-size: 24rpx;
    font-weight: 400;
    line-height: 33rpx;
    max-width: 11em;
    overflow: hidden;
    padding-right: 28rpx;
    position: relative;
    -o-text-overflow: ellipsis;
    text-overflow: ellipsis;
    white-space: nowrap
}

.company-info-item::after {
    background: #eee;
    content: "";
    height: 22rpx;
    position: absolute;
    right: 14rpx;
    top: 50%;
    -webkit-transform: translateY(-50%);
    -ms-transform: translateY(-50%);
    transform: translateY(-50%);
    width: 2rpx
}

.company-info-item:last-child {
    padding-right: 0
}

.company-info-item:last-child::after {
    content: none
}

.company-logo {
    border: 1rpx solid #e7e7ef;
    border-radius: 16rpx;
    height: 100rpx;
    margin-right: 20rpx;
    width: 100rpx
}

.company-card-footer {
    -ms-flex-pack: center;
    color: #999;
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    font-size: 32rpx;
    font-weight: 400;
    -webkit-justify-content: center;
    justify-content: center;
    line-height: 33rpx;
    margin-top: 32rpx
}

.company-card-footer .icon {
    font-size: 26rpx;
    margin-right: 8rpx
}

.company-card-footer .icon-jiantou {
    font-size: 16rpx;
    margin-left: 8rpx
}

.comment-container .comment-rate,.post-item {
    -webkit-box-sizing: border-box;
    box-sizing: border-box
}

.post-item {
    background: rgba(245,246,250,.77);
    border-radius: 16rpx;
    margin-bottom: 16rpx;
    padding: 24rpx 16rpx;
    width: 100%
}

.post-content,.post-header {
    -ms-flex-pack: justify;
    -ms-flex-align: center;
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    -webkit-justify-content: space-between;
    justify-content: space-between
}

.post-header {
    margin-bottom: 25rpx
}

.post-name,.post-salary {
    font-size: 30rpx;
    font-weight: 500
}

.post-name {
    color: #1f1f2c;
    line-height: 30rpx;
    max-width: 12em
}

.post-salary {
    color: #ff4a40;
    line-height: 42rpx
}

.tag-list {
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex
}

.post-list {
    margin-top: 34rpx
}

.comments,.post-location,.tag-item {
    font-size: 22rpx;
    font-weight: 400;
    line-height: 30rpx
}

.tag-item {
    color: #6c6d73;
    margin-right: 38rpx;
    max-width: 7em
}

.comments,.post-location {
    color: #a8a9b3
}

.comments {
    color: #333;
    font-size: 26rpx;
    line-height: 37rpx;
    padding-left: 40rpx
}

.comment-container {
    -ms-flex-align: center;
    -webkit-align-items: center;
    align-items: center;
    background: -webkit-gradient(linear,right top,left top,from(#f5f6fa),to(#fff));
    background: -webkit-linear-gradient(right,#f5f6fa,#fff);
    background: -o-linear-gradient(right,#f5f6fa 0,#fff 100%);
    background: linear-gradient(270deg,#f5f6fa,#fff);
    border-radius: 8rpx;
    height: 119rpx;
    margin-top: 24rpx;
    width: 100%
}

.comment-container .comment-rate {
    -ms-flex-negative: 0;
    -webkit-flex-shrink: 0;
    flex-shrink: 0;
    padding-left: 20rpx;
    position: relative;
    width: 40%
}

.comment-container .comment-rate::after {
    background: #eee;
    -webkit-box-sizing: border-box;
    box-sizing: border-box;
    content: "";
    height: 87rpx;
    position: absolute;
    right: 0;
    top: 16rpx;
    width: 1rpx
}

.comment-container,.comment-container .rate-text {
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex
}

.comment-container .rate-text {
    -ms-flex-align: baseline;
    -webkit-align-items: baseline;
    align-items: baseline;
    color: #1f1f2c;
    font-size: 40rpx;
    line-height: 56rpx;
    margin-left: 5rpx;
    margin-top: 15rpx
}

.comment-container .rate-text-arrow {
    color: #a8a9b3;
    font-size: 20rpx;
    font-weight: 400;
    line-height: 28rpx;
    margin-left: 12rpx
}

.comment-container .rate-text-arrow .icon {
    color: #dbdbdb;
    margin-left: 8rpx
}

.company-card--has-post {
    border-radius: 24rpx;
    padding: 32rpx
}

.company-card--has-post .company-logo {
    border: 0;
    border-radius: 16rpx;
    height: 88rpx;
    margin-right: 32rpx;
    width: 88rpx
}

.company-card--has-post .company-name-row {
    -ms-flex-align: center;
    -ms-flex-pack: justify;
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    -webkit-justify-content: space-between;
    justify-content: space-between;
    margin-bottom: 4rpx
}

.company-card--has-post .company-name {
    color: #13151a;
    -webkit-flex: 1;
    -ms-flex: 1;
    flex: 1;
    font-size: 32rpx;
    line-height: 48rpx;
    margin-bottom: 0;
    margin-top: 0
}

.company-card--has-post .company-name-arrow {
    -ms-flex-negative: 0;
    color: #86909c;
    -webkit-flex-shrink: 0;
    flex-shrink: 0;
    font-size: 20rpx
}

.company-card--has-post .company-info-item {
    color: #86909c;
    font-size: 26rpx;
    line-height: 44rpx;
    padding-right: 16rpx
}

.company-card--has-post .company-info-item::after {
    background: #e5e6eb;
    height: 16rpx;
    right: 8rpx
}

.company-card--has-post .post-list {
    margin-top: 24rpx
}

.company-card--has-post .company-card-footer {
    -ms-flex-align: center;
    -webkit-align-items: center;
    align-items: center;
    color: #86909c;
    font-size: 26rpx;
    line-height: 44rpx;
    margin-top: 24rpx
}

.company-card--has-post .company-card-footer .icon-xialasanjiao {
    font-size: 32rpx;
    margin-right: 4rpx
}

.company-card--has-post .company-card-footer .footer-count {
    color: #ff453a
}
