.company-post-item {
    border-bottom: 1rpx solid rgba(242,243,245,.7);
    -webkit-box-sizing: border-box;
    box-sizing: border-box;
    padding: 16rpx 0;
    width: 100%
}

.company-post-item__row {
    -ms-flex-pack: justify;
    -ms-flex-align: start;
    -webkit-align-items: flex-start;
    align-items: flex-start;
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    -webkit-justify-content: space-between;
    justify-content: space-between
}

.company-post-item__row+.company-post-item__row {
    margin-top: 4rpx
}

.company-post-item__name {
    color: #13151a;
    -webkit-flex: 1;
    -ms-flex: 1;
    flex: 1;
    font-size: 28rpx;
    font-weight: 500;
    line-height: 44rpx;
    margin-right: 16rpx;
    min-width: 0
}

.company-post-item__salary {
    -ms-flex-negative: 0;
    color: #ff453a;
    -webkit-flex-shrink: 0;
    flex-shrink: 0;
    font-size: 28rpx;
    font-weight: 500;
    line-height: 44rpx;
    text-align: right;
    white-space: nowrap
}

.company-post-item__tags {
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    -webkit-flex: 1;
    -ms-flex: 1;
    flex: 1;
    -webkit-flex-wrap: wrap;
    -ms-flex-wrap: wrap;
    flex-wrap: wrap;
    gap: 12rpx;
    min-width: 0
}

.company-post-item__tag {
    background: #f7f8fa;
    border-radius: 8rpx;
    color: #4e5969;
    font-size: 22rpx;
    font-weight: 400;
    line-height: 32rpx;
    padding: 2rpx 12rpx;
    white-space: nowrap
}

.company-post-item__tag--highlight {
    background: rgba(255,247,232,.7);
    color: #d25f00
}

.company-post-item__location {
    -ms-flex-negative: 0;
    color: #86909c;
    -webkit-flex-shrink: 0;
    flex-shrink: 0;
    font-size: 24rpx;
    font-weight: 400;
    line-height: 28rpx;
    margin-left: 16rpx;
    text-align: right;
    white-space: nowrap
}
