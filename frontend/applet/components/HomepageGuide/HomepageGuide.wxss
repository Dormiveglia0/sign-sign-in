.full-mask {
    background-color: rgba(0,0,0,.7);
    height: 100vh;
    left: 0;
    position: fixed;
    top: 0;
    width: 100vw;
    z-index: 1000
}

.welcom-image {
    height: 560rpx;
    left: 50%;
    position: absolute;
    top: 50%;
    -webkit-transform: translate(-50%,-50%);
    -ms-transform: translate(-50%,-50%);
    transform: translate(-50%,-50%);
    width: 580rpx
}

.guide-image-1 {
    left: 14rpx;
    position: absolute;
    top: 36rpx;
    width: 347rpx
}

.guide-image-2 {
    bottom: 0;
    left: 108rpx;
    position: absolute;
    width: 479rpx
}

.guide-image-3,.guide-image-4 {
    left: 140rpx;
    position: absolute;
    top: 28rpx;
    width: 490rpx
}

.guide-image-4 {
    background-color: #fff;
    border-radius: 28rpx;
    height: 608rpx;
    left: 11.5%;
    top: 30%;
    width: 580rpx
}

.guide-image-4 .gudie4_title {
    color: #000;
    font-size: 32rpx;
    font-weight: 700;
    margin: 75rpx 40rpx 40rpx
}

.guide-image-4 .project_box {
    padding: 0 40rpx
}

.guide-image-4 .project_box .project_1 {
    -ms-flex-align: center;
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    margin-bottom: 50rpx;
    position: relative
}

.guide-image-4 .project_box .project_1 .line_css {
    position: relative
}

.guide-image-4 .project_box .project_1 .line_css:before {
    background-color: #ff7a59;
    content: "";
    height: 100%;
    left: 50%;
    position: absolute;
    top: 70rpx;
    -webkit-transform: translate(-50%,0);
    -ms-transform: translate(-50%,0);
    transform: translate(-50%,0);
    width: 1rpx
}

.guide-image-4 .project_box .project_1 .img_box {
    height: 52rpx;
    margin-right: 30rpx;
    margin-top: -60rpx;
    width: 52rpx
}

.guide-image-4 .project_box .project_1 .img_box wx-image,.iphoneX .guide-image-4 .project_box .project_1 .img_box wx-image {
    height: 100%;
    width: 100%
}

.guide-image-4 .project_box .project_1 .info_box {
    -webkit-flex: 1;
    -ms-flex: 1;
    flex: 1;
    font-weight: 400;
    position: relative;
    text-align: left
}

.guide-image-4 .project_box .project_1 .info_box .tips_tag {
    background: #fd4848;
    border: 2rpx solid #fff;
    border-radius: 20rpx;
    color: #fff;
    font-size: 18rpx;
    font-weight: 500;
    height: 37rpx;
    left: 120rpx;
    line-height: 37rpx;
    position: absolute;
    text-align: center;
    top: -25rpx;
    width: 84rpx
}

.guide-image-4 .project_box .project_1 .info_box .tips_tag:before,.iphoneX .guide-image-4 .project_box .project_1 .info_box .tips_tag:before {
    border-color: #fd4848 transparent transparent;
    border-style: solid;
    border-width: 8rpx 10rpx 10rpx 2rpx;
    content: "";
    height: 0;
    left: 20%;
    position: absolute;
    top: 99%;
    -webkit-transform: translate(-50%,0);
    -ms-transform: translate(-50%,0);
    transform: translate(-50%,0);
    width: 0
}

.guide-image-4 .project_box .project_1 .info_box .info_title {
    color: #000;
    font-size: 30rpx
}

.guide-image-4 .project_box .project_1 .info_box .info_2 {
    color: #666;
    font-size: 24rpx;
    margin-top: 10rpx
}

.guide-image-4 .project_box .project_1 .info_box .info_2 .red_text,.iphoneX .guide-image-4 .project_box .project_1 .info_box .info_2 .red_text {
    color: #f25451!important
}

.guide-image-4 .project_box .project_1 .btn_text {
    color: #4990e2;
    font-size: 28rpx;
    font-weight: 400;
    position: absolute;
    right: 30rpx;
    top: 0
}

