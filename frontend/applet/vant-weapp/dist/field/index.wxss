.van-ellipsis,.van-multi-ellipsis--l2,.van-multi-ellipsis--l3 {
    overflow: hidden;
    -o-text-overflow: ellipsis;
    text-overflow: ellipsis
}

.van-ellipsis {
    white-space: nowrap
}

.van-multi-ellipsis--l2,.van-multi-ellipsis--l3 {
    -webkit-line-clamp: 2;
    display: -webkit-box
}

.van-multi-ellipsis--l3 {
    -webkit-line-clamp: 3
}

.van-clearfix:after {
    clear: both;
    content: "";
