var bem = require('p_./vant-weapp/dist/wxs/bem.wxs')().bem;
var memoize = require('p_./vant-weapp/dist/wxs/memoize.wxs')().memoize;

function isSrc(url) {
  return (url.indexOf('http') === 0 || url.indexOf('data:image') === 0 || url.indexOf('//') === 0)
};
module.exports = ({
  bem: memoize(bem),
  isSrc: isSrc,
  memoize: memoize,
});