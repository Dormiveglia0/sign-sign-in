.question-box {
    padding: 0 20rpx
}

.question-box .title-text {
    color: #1f1f2c;
    font-size: 28rpx;
    font-weight: 600;
    margin-bottom: 30rpx
}

.question-box .jump-text,.question-box .scroll-text {
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex
}

.question-box .jump-text {
    -ms-flex-align: center;
    -ms-flex-pack: center;
    -webkit-align-items: center;
    align-items: center;
    color: #999;
    font-size: 24rpx;
    font-weight: 400;
    -webkit-justify-content: center;
    justify-content: center;
    margin: 40rpx auto 0;
    text-align: center
}

.question-box .jump-text .icon-fanhui-copy-copy {
    color: #dbdbdb;
    font-size: 20rpx;
    margin-left: 10rpx
}

.question-box .scroll-text {
    margin-bottom: 20rpx
}

.question-box .scroll-text .emoji-text {
    padding-right: 8rpx;
    padding-top: 8rpx
}

.question-box .text-item {
    background: #fff;
    border: 1rpx solid #9ab9dd;
    border-radius: 24rpx 24rpx 24rpx 0;
    color: #1f1f2c;
    font-size: 24rpx;
    font-weight: 400;
    height: 52rpx;
    line-height: 52rpx;
    margin-right: 15rpx;
    padding: 0 20rpx;
    text-align: center
}

.question-box .scrollview_box {
    overflow-x: scroll;
    white-space: nowrap
}
