.more-filter,.more-filter-bar {
    -webkit-box-sizing: border-box;
    box-sizing: border-box
}

.more-filter-bar {
    -ms-flex-pack: justify;
    -ms-flex-align: center;
    -webkit-align-items: center;
    align-items: center;
    background: #f9fafc;
    border-bottom: 1rpx solid #dbdbdb;
    border-radius: 28rpx 28rpx 0 0;
    color: #333;
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    font-size: 30rpx;
    font-weight: 500;
    height: 96rpx;
    -webkit-justify-content: space-between;
    justify-content: space-between;
    line-height: 42rpx;
    padding: 0 40rpx;
    width: 100%
}

.more-filter {
    background: #fff;
    max-height: 50vh;
    overflow-y: auto;
    padding: 48rpx 32rpx 0
}

.more-filter-title {
    color: #1f1f2c;
    font-size: 30rpx;
    font-weight: 500;
    line-height: 48rpx;
    margin-bottom: 28rpx
}

.more-filter-content {
    grid-gap: 16rpx;
    display: grid;
    grid-template-columns: repeat(3,1fr);
    margin-bottom: 48rpx
}

.item {
    background: #fafafa;
    border: 1rpx solid #fafafa;
    border-radius: 36rpx;
    color: #45454d;
    font-size: 28rpx;
    font-weight: 400;
    height: 72rpx;
    line-height: 72rpx;
    text-align: center
}

.item-active {
    background: hsla(0,0%,100%,.1);
    border: 1rpx solid #ff453a;
    border-radius: 36rpx;
    color: #ff453a
}

.more-filter-btn {
    background-color: #fff;
    -webkit-box-sizing: border-box;
    box-sizing: border-box;
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    padding: 20rpx 20rpx env(safe-area-inset-bottom);
    width: 100%
}

.more-filter-btn .confirm,.more-filter-btn .reset {
    border-radius: 16rpx;
    height: 88rpx;
    line-height: 88rpx;
    text-align: center
}

.more-filter-btn .reset {
    background: #fff;
    border: 1rpx solid #ff453a;
    color: #ff453a;
    font-size: 32rpx;
    font-weight: 400;
    margin-right: 20rpx;
    width: 210rpx
}

.more-filter-btn .confirm {
    background: #ff453a;
    color: #fff;
    -webkit-flex: 1;
    -ms-flex: 1;
    flex: 1
}
