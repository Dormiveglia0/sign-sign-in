.banner,.swiperContainer {
    position: relative;
    width: 100%;
    z-index: 9
}

.banner {
    -webkit-box-sizing: border-box;
    box-sizing: border-box
}

.swiperContainer {
    border-radius: 8rpx;
    height: 240rpx
}

.swiperContainer .slide-image {
    border-radius: 8rpx;
    height: 100%;
    width: 100%
}

.banner .dots {
    -ms-flex-pack: center;
    -ms-flex-align: center;
    -webkit-align-items: center;
    align-items: center;
    bottom: 10rpx;
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    -webkit-flex-direction: row;
    -ms-flex-direction: row;
    flex-direction: row;
    height: auto;
    -webkit-justify-content: center;
    justify-content: center;
    position: absolute;
    width: 100%;
    z-index: 10
}

.banner .dots .dots_box,.banner .dots .dots_box .dot {
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    height: 6rpx
}

.banner .dots .dots_box {
    background: #fff;
    border-radius: 3rpx;
    width: 60rpx
}

.banner .dots .dots_box .dot {
    background-color: #fff;
    -webkit-flex: 1;
    -ms-flex: 1;
    flex: 1
}

.banner .dots .dots_box .dot.active {
    background: #ff453a;
    border-radius: 3rpx
}
