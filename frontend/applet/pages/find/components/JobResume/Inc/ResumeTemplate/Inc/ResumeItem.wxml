<view bindtap="anonymousFunc0" class="{{[ (index+1)%3==0?'template_item mgr0':'template_item',type==1?'template_width':'' ]}}" wx:if="{{$taroCompReady}}">
    <view wx:if="{{type==0}}">
        <image class="tem_img" lazyLoad="false" mode="aspectFill" src="{{itemData.imgFilePath}}"></image>
        <view class="template_name">{{itemData.name}}</view>
    </view>
    <view wx:if="{{type==1}}">
        <image class="tem_img_list" lazyLoad="false" mode="aspectFill" src="{{itemData.imgFilePath}}"></image>
        <view class="template_name_list">{{itemData.name}}</view>
    </view>
</view>
