.template_item {
    margin-bottom: 20rpx;
    margin-right: 16rpx;
    width: 222rpx
}

.template_item .tem_img,.template_item .tem_img_list {
    background: #fff;
    border: 1rpx solid #e6e6e6;
    border-radius: 16rpx 16rpx 0 0;
    height: 246rpx;
    width: 100%
}

.template_item .tem_img_list {
    height: 355rpx
}

.template_item .template_name,.template_item .template_name_list {
    background: #fff;
    border-radius: 0 0 16rpx 16rpx;
    -webkit-box-shadow: 0 -6rpx 14rpx 0 rgba(77,90,113,.1);
    box-shadow: 0 -6rpx 14rpx 0 rgba(77,90,113,.1);
    color: #5c5c66;
    font-size: 24rpx;
    font-weight: 400;
    margin-top: -10rpx;
    padding: 10rpx 10rpx 10rpx 20rpx;
    text-align: left
}

.template_item .template_name_list {
    font-size: 28rpx;
    height: 45rpx;
    padding: 20rpx 20rpx 20rpx 25rpx
}

.template_width {
    margin-right: 0!important;
    width: 320rpx!important
}

.mgr0 {
    margin-right: 0
}
