.popup-wrap {
    background: #fff;
    border-radius: 28rpx 28rpx 0 0;
    height: 812rpx;
    width: 100%
}

.popup-title {
    -ms-flex-align: center;
    -ms-flex-pack: justify;
    -webkit-align-items: center;
    align-items: center;
    border-bottom: 1rpx solid #dbdbdb;
    color: #333;
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    font-size: 32rpx;
    font-weight: 500;
    height: 106rpx;
    -webkit-justify-content: space-between;
    justify-content: space-between;
    padding: 0 40rpx
}

.popup-item,.popup-list,.popup-title {
    -webkit-box-sizing: border-box;
    box-sizing: border-box;
    width: 100%
}

.popup-list {
    margin-top: 19rpx;
    padding: 0 24rpx
}

.popup-item {
    border-radius: 16rpx;
    font-size: 30rpx;
    height: 96rpx;
    line-height: 96rpx;
    padding: 0 26rpx
}

.popup-item-active {
    background: #f5f5f5
}

.close-icon {
    color: rgba(0,0,0,.54)
}
