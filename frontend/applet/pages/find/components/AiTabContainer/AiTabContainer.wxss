.ai-avatar-wrap .ai-tag.ai-tag-4 {
    background: -webkit-gradient(linear,left top,right top,from(rgba(105,221,214,.66)),to(rgba(20,163,235,.66)));
    background: -webkit-linear-gradient(left,rgba(105,221,214,.66),rgba(20,163,235,.66));
    background: -o-linear-gradient(left,rgba(105,221,214,.66) 0,rgba(20,163,235,.66) 100%);
    background: linear-gradient(90deg,rgba(105,221,214,.66),rgba(20,163,235,.66))
