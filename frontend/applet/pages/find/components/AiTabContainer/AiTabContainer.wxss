.ai-container-wrap {
    background-color: #e7e8fb;
    position: relative
}

.ai-container-wrap::before {
    background: -webkit-gradient(linear,left top,left bottom,from(#f4f5fa),to(hsla(0,0%,100%,0)));
    background: -webkit-linear-gradient(top,#f4f5fa,hsla(0,0%,100%,0));
    background: -o-linear-gradient(top,#f4f5fa 0,hsla(0,0%,100%,0) 100%);
    background: linear-gradient(180deg,#f4f5fa,hsla(0,0%,100%,0));
    content: "";
    height: 718rpx;
    left: 0;
    position: absolute;
    top: 0;
    width: 100%;
    z-index: 0
}

.ai-container-wrap::after {
    background: #dac5ff;
    content: "";
    -webkit-filter: blur(50rpx);
    filter: blur(50rpx);
    height: 564rpx;
    opacity: .2;
    position: absolute;
    right: 0;
    top: 154rpx;
    width: 420rpx
}

.ai-container {
    position: relative;
    z-index: 1
}

.ai-avatar-big {
    border-radius: 50%;
    display: block;
    height: 200rpx;
    margin: 40rpx auto 20rpx;
    width: 200rpx
}

.ai-card-list,.ai-text {
    -webkit-box-sizing: border-box;
    box-sizing: border-box;
    padding: 0 32rpx
}

.ai-text {
    background: #fff;
    border-radius: 0 32rpx 32rpx 32rpx;
    color: #1f1f2c;
    font-size: 26rpx;
    font-weight: 400;
    line-height: 37rpx;
    padding: 32rpx 40rpx;
    width: 100%
}

.ai-avatar-wrap,.ai-item {
    -ms-flex-align: center;
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex
}

.ai-item {
    background: #fff;
    border-radius: 37rpx;
    -webkit-box-sizing: border-box;
    box-sizing: border-box;
    height: 140rpx;
    margin-top: 16rpx;
    padding: 0 32rpx;
    position: relative;
    width: 100%
}

.ai-item .icon-jiantou {
    color: #d8d8d8;
    font-size: 24rpx;
    position: absolute;
    right: 32rpx;
    top: 50%;
    -webkit-transform: translateY(-50%);
    -ms-transform: translateY(-50%);
    transform: translateY(-50%)
}

.ai-avatar-wrap {
    -ms-flex-pack: center;
    -webkit-flex-direction: column;
    -ms-flex-direction: column;
    flex-direction: column;
    -webkit-justify-content: center;
    justify-content: center;
    margin-right: 30rpx
}

.ai-avatar-wrap .ai-avatar {
    border-radius: 50%;
    height: 80rpx;
    width: 80rpx
}

.ai-avatar-wrap .ai-tag {
    border-radius: 10rpx;
    color: #fff;
    font-size: 18rpx;
    font-weight: 600;
    height: 31rpx;
    line-height: 31rpx;
    margin-top: -6rpx;
    text-align: center;
    width: 106rpx
}

.ai-avatar-wrap .ai-tag.ai-tag-1 {
    background: -webkit-gradient(linear,left top,right top,from(rgba(172,126,253,.66)),to(rgba(20,21,235,.66)));
    background: -webkit-linear-gradient(left,rgba(172,126,253,.66),rgba(20,21,235,.66));
    background: -o-linear-gradient(left,rgba(172,126,253,.66) 0,rgba(20,21,235,.66) 100%);
    background: linear-gradient(90deg,rgba(172,126,253,.66),rgba(20,21,235,.66))
