.ai-avatar-wrap .ai-tag.ai-tag-2 {
    background: -webkit-gradient(linear,left top,right top,from(rgba(105,205,221,.66)),to(rgba(20,66,235,.66)));
    background: -webkit-linear-gradient(left,rgba(105,205,221,.66),rgba(20,66,235,.66));
    background: -o-linear-gradient(left,rgba(105,205,221,.66) 0,rgba(20,66,235,.66) 100%);
    background: linear-gradient(90deg,rgba(105,205,221,.66),rgba(20,66,235,.66))
}

.ai-avatar-wrap .ai-tag.ai-tag-3 {
    background: -webkit-gradient(linear,left top,right top,from(rgba(248,139,90,.66)),to(rgba(235,20,20,.66)));
    background: -webkit-linear-gradient(left,rgba(248,139,90,.66),rgba(235,20,20,.66));
    background: -o-linear-gradient(left,rgba(248,139,90,.66) 0,rgba(235,20,20,.66) 100%);
    background: linear-gradient(90deg,rgba(248,139,90,.66),rgba(235,20,20,.66))
