    margin-left: 15rpx;
    text-align: center
}

.enterprise_tag_new {
    border: 1rpx solid #ff6043;
    color: #ff6043;
    font-size: 28rpx;
    font-weight: 400;
    height: 30rpx;
    width: 60rpx
}

.enterprise_tag_new_cn,.enterprise_tag_new_cn-img {
    color: #f25451;
    font-size: 22rpx;
    font-weight: 600;
    padding: 2rpx 8rpx
}

.enterprise_tag_new_cn {
    background: #fff4f4;
    border: 1rpx solid #f25451
}

.enterprise_tag_new_cn-img {
    background-image: url(https://xcxstatic.xybsyw.com/xcx/images/post-card-new.png);
