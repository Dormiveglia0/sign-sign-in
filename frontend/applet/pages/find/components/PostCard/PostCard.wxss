}

.more-button {
    color: #4990e2;
    font-size: 24rpx;
    line-height: 112rpx;
    margin: 20rpx 0;
    text-align: center
}

.positive_frame {
    color: #17b87c;
    display: inline-block;
    font-size: 22rpx;
    font-weight: 400;
    height: 30rpx;
    margin-left: 10rpx;
    padding-left: 24rpx;
