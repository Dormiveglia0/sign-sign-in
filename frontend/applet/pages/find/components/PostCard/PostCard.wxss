.post_box {
    background: #fff;
    border-radius: 16rpx;
    -webkit-box-sizing: border-box;
    box-sizing: border-box;
    margin-bottom: 20rpx;
    padding: 28rpx 24rpx;
    position: relative;
    width: 100%
}

.post_box .post_top {
    -ms-flex-pack: justify;
    -ms-flex-line-pack: center;
    -webkit-align-content: center;
    align-content: center;
    -webkit-justify-content: space-between;
    justify-content: space-between
}

.post_box .post_top .post_name_active {
    font-size: 24rpx!important
}

.post_box .post_top .post_name {
    -ms-flex-align: center;
    -webkit-align-items: center;
    align-items: center;
    color: #1f1f2c;
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    font-size: 32rpx;
    font-weight: 500;
    line-height: 48rpx;
    max-width: 500rpx
}

.post_box .post_top .post_name>.post_name-text {
    max-width: 12em
}

.post_box .post_top .post_name>.short_name {
    max-width: 7em
}

.post_box .post_top .post_name .nature_text {
    background: #edf3fe;
    border-radius: 4rpx;
    color: #4990e2;
    font-size: 20rpx;
    font-weight: 400;
    height: 40rpx;
    line-height: 40rpx;
    margin-left: 8rpx;
    padding: 0 8rpx
}

.post_box .post_top .post_money {
    color: #ff453a;
    font-size: 32rpx;
    font-weight: 500;
    line-height: 42rpx;
    margin-left: 8rpx;
    max-width: 260rpx
}

.post_box .post_top .post_money_active {
    float: right;
    font-size: 24rpx;
    text-align: right
}

.post_box .post_bottom,.post_box .post_center,.post_box .post_top {
    -ms-flex-align: center;
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex
}

.post_box .post_center {
    -ms-flex-pack: justify;
    -ms-flex-line-pack: center;
    -webkit-align-content: center;
    align-content: center;
    height: 38rpx;
    -webkit-justify-content: space-between;
    justify-content: space-between;
    margin-top: 10rpx;
    overflow: hidden
}

.post_box .post_center .post_welfare_box {
    -webkit-flex: none;
    -ms-flex: none;
    flex: none
}

.post_box .post_center .post_welfare_box .post_welfare {
    background: #fafafa;
    border-radius: 4rpx;
    -webkit-box-sizing: border-box;
    box-sizing: border-box;
    color: #6c6d73;
    display: inline-block;
    font-size: 22rpx;
    font-weight: 400;
    height: 34rpx;
    line-height: 34rpx;
    margin-right: 13rpx;
    max-width: 6em;
    overflow: hidden;
    padding: 0 8rpx;
    -o-text-overflow: ellipsis;
    text-overflow: ellipsis;
    vertical-align: bottom;
    white-space: nowrap
}

.post_box .post_center .post_welfare_box .post_welfare.highlight {
    background: #fdf7f6;
    color: #b77358
}

.post_box .post_center .post_welfare_box .disNone {
    display: none
}

.post_box .post_bottom {
    margin-top: 24rpx;
    position: relative
}

.post_box .post_bottom .post_icon {
    border: 1rpx solid #efeeee;
    border-radius: 50%;
    height: 40rpx;
    margin-right: 13rpx;
    min-width: 40rpx;
    overflow: hidden;
    width: 40rpx
}

.post_box .post_bottom .post_icon wx-image {
    height: 40rpx;
    width: 40rpx
}

.post_box .post_bottom .post_content {
    -webkit-flex: 1;
    -ms-flex: 1;
    flex: 1
}

.post_box .post_bottom .post_content .post_company,.post_box .post_bottom .post_content .post_text {
    -ms-flex-align: center;
    -webkit-align-items: center;
    align-items: center;
    color: #1f1f2c;
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    font-size: 26rpx;
    line-height: 33rpx
}

.post_box .post_bottom .post_content .post_company>.enterprise-name {
    max-width: 267rpx
}

.post_box .post_bottom .post_content .post_text {
    -ms-flex-pack: justify;
    -ms-flex-line-pack: center;
    -webkit-align-content: center;
    align-content: center;
    color: #a8a9b3;
    font-size: 22rpx;
    font-weight: 400;
    -webkit-justify-content: space-between;
    justify-content: space-between;
    margin-top: 8rpx
}

.post_box .post_bottom .post_content .post_text .tag {
    display: inline-block
}

.post_box .post_bottom .post_content .post_text .line {
    background: #a8a9b3;
    display: inline-block;
    height: 20rpx;
    margin: 0 12rpx;
    vertical-align: middle;
    width: 2rpx
}

.post_box .double-tag,.post_box .post_bottom .post_content .post_text .post_text_left {
    -ms-flex-align: center;
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex
}

.post_box .post_bottom .post_content .post_text .post_text_left {
    -webkit-flex: 1;
    -ms-flex: 1;
    flex: 1
}

.post_box .double-tag {
    background: -webkit-gradient(linear,right top,left top,from(#fff),to(#edf3ff));
    background: -webkit-linear-gradient(right,#fff,#edf3ff);
    background: -o-linear-gradient(right,#fff 0,#edf3ff 100%);
    background: linear-gradient(270deg,#fff,#edf3ff);
    border-radius: 24rpx;
    height: 48rpx;
    line-height: 48rpx;
    margin-top: 20rpx;
    padding-left: 20rpx;
    text-align: center;
    width: 605rpx
}

.post_box .double-tag .icon-sxh-text {
    height: 20rpx;
    margin-right: 15rpx;
    width: 71rpx
}

.post_box .double-tag .double-tag-text {
    color: #666;
    font-size: 24rpx;
    font-weight: 400;
    overflow: hidden;
    -o-text-overflow: ellipsis;
    text-overflow: ellipsis;
    white-space: nowrap
}

.post_box .post_text_right {
    color: #a8a9b3;
    font-size: 24rpx;
    max-width: 5em
}

.post_box .right-bottom {
    -ms-flex-align: end;
    -webkit-align-items: flex-end;
    align-items: flex-end;
    bottom: 0;
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    height: 75rpx;
    position: absolute;
    right: 0
}

.post_box_border {
    border: 1rpx solid #e6e6e6
}

.noDataView {
    padding: 20rpx 0;
    text-align: center
}

.noDataView .noDataPic {
    height: 280rpx;
    margin: 0 auto;
    width: 450rpx
}

.noDataView .noDataText1 {
    color: #aeb2b8;
    font-size: 28rpx;
    font-weight: 500;
    line-height: 44rpx;
    margin: 0 auto
}

.noDataView .noDataText1>wx-text {
    color: #4990e2
}

.loading,.nodata {
    height: 112rpx;
    text-align: center;
    width: 100%
}

.loading {
    background: #f0f0f0;
    -webkit-box-sizing: border-box;
    box-sizing: border-box;
    padding-top: 32rpx;
    position: relative
}

.nodata {
    color: #b2b2b2;
    line-height: 112rpx
}

.nodata_iphonex {
    height: 172rpx
}

.nodata wx-text {
    font-size: 22rpx;
    position: relative
}

.blankView {
    height: 112rpx
}

.enterprise-tag-new,.enterprise-tag-new-cn {
    display: inline-block;
    height: 31px;
    margin-left: 8rpx;
    position: relative;
    width: 53rpx
}

.enterprise-tag-new-cn {
    height: 40rpx;
    width: 100rpx
}

.enterprise_tag_new,.enterprise_tag_new_cn,.enterprise_tag_new_cn-img {
