.at-activity-indicator {
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    line-height: 1;
    opacity: 0;
    -webkit-transition: all .3s cubic-bezier(.55,.085,.68,.53);
    -o-transition: all .3s cubic-bezier(.55,.085,.68,.53);
    transition: all .3s cubic-bezier(.55,.085,.68,.53);
    visibility: hidden
}

.at-activity-indicator__body,.at-activity-indicator__content {
    -webkit-box-flex: 0;
    -webkit-flex: 0 0 auto;
    -ms-flex: 0 0 auto;
    flex: 0 0 auto
}

.at-activity-indicator__page {
    line-height: 0
}

.at-activity-indicator__content {
    -ms-flex-item-align: center;
    -webkit-align-self: center;
    align-self: center;
    color: #999;
    font-size: 28rpx;
    margin-left: 24rpx
}

.at-activity-indicator--center {
    left: 50%;
    position: absolute;
    top: 50%;
    -webkit-transform: translate(-50%,-50%);
    -ms-transform: translate(-50%,-50%);
    transform: translate(-50%,-50%)
}

.at-activity-indicator--isopened {
    opacity: 1;
    visibility: initial
}

.at-loading,.at-loading__ring {
    display: inline-block;
    height: 36rpx;
    position: relative;
    width: 36rpx
}

.at-loading__ring {
    -webkit-animation: loading 1.2s cubic-bezier(.5,0,.5,1) infinite;
    animation: loading 1.2s cubic-bezier(.5,0,.5,1) infinite;
    border: 1px solid transparent;
    border-radius: 50%;
    border-top-color: #6190e8;
    -webkit-box-sizing: border-box;
    box-sizing: border-box;
    display: block;
    margin: 1PX;
    position: absolute
}

.at-loading__ring:nth-child(1) {
    -webkit-animation-delay: -.45s;
    animation-delay: -.45s
}

.at-loading__ring:nth-child(2) {
    -webkit-animation-delay: -.3s;
    animation-delay: -.3s
}

.at-loading__ring:nth-child(3) {
    -webkit-animation-delay: -.15s;
    animation-delay: -.15s
}

.at-action-sheet {
    height: 100%;
    left: 0;
    position: fixed;
    top: 0;
    -webkit-transition: visibility .3s cubic-bezier(.36,.66,.04,1);
    -o-transition: visibility .3s cubic-bezier(.36,.66,.04,1);
    transition: visibility .3s cubic-bezier(.36,.66,.04,1);
    visibility: hidden;
    width: 100%;
    z-index: 1010
}

.at-action-sheet__overlay {
    background-color: rgba(0,0,0,.3);
    height: 100%;
    left: 0;
    opacity: 0;
    position: absolute;
    top: 0;
    -webkit-transition: opacity .3s ease-in;
    -o-transition: opacity .3s ease-in;
    transition: opacity .3s ease-in;
    width: 100%
}

.at-action-sheet__container {
    background-color: #fff;
    bottom: 0;
    padding-bottom: env(safe-area-inset-bottom);
    position: absolute;
    text-align: center;
    -webkit-transform: translate3d(0,100%,0);
    transform: translate3d(0,100%,0);
    -webkit-transition: -webkit-transform .3s cubic-bezier(.36,.66,.04,1);
    -o-transition: transform .3s cubic-bezier(.36,.66,.04,1);
    transition: -webkit-transform .3s cubic-bezier(.36,.66,.04,1);
    transition: transform .3s cubic-bezier(.36,.66,.04,1);
    transition: transform .3s cubic-bezier(.36,.66,.04,1),-webkit-transform .3s cubic-bezier(.36,.66,.04,1);
    width: 100%
}

.at-action-sheet__header {
    color: #b2b2b2;
    font-size: 28rpx;
    line-height: 1.5;
    padding: 24rpx;
    position: relative;
    text-align: center
}

.at-action-sheet__header::after,.at-action-sheet__item::after {
    -webkit-box-sizing: border-box;
    box-sizing: border-box;
    content: "";
    pointer-events: none;
    position: absolute;
    -webkit-transform-origin: center;
    -ms-transform-origin: center;
    transform-origin: center
}

.at-action-sheet__header::after {
    border: solid #d6e4ef;
    border-width: 0 0 1px;
    bottom: -50%;
    left: -50%;
    right: -50%;
    top: -50%;
    -webkit-transform: scale(.5);
    -ms-transform: scale(.5);
    transform: scale(.5)
}

.at-action-sheet__footer {
    border-top: 12rpx solid rgba(197,217,232,.3);
    font-size: 36rpx;
    padding: 24rpx;
    -webkit-transition: background-color .3s;
    -o-transition: background-color .3s;
    transition: background-color .3s
}

.at-action-sheet__footer:active,.at-action-sheet__item:active {
    background-color: #f0f0f0
}

.at-action-sheet__page {
    text-align: center
}

.at-action-sheet__item {
    font-size: 36rpx;
    overflow: hidden;
    padding: 24rpx;
    position: relative;
    -o-text-overflow: ellipsis;
    text-overflow: ellipsis;
    -webkit-transition: background-color .3s;
    -o-transition: background-color .3s;
    transition: background-color .3s;
    white-space: nowrap
}

.at-action-sheet__item::after {
    border-bottom: 1px solid #d6e4ef;
    bottom: 0;
    left: 0;
    right: 0;
    top: auto;
    -webkit-transform: scaleY(.5);
    -ms-transform: scaleY(.5);
    transform: scaleY(.5)
}

.at-action-sheet--active {
    visibility: visible
}

.at-action-sheet--active .at-action-sheet__overlay {
    opacity: 1
}

.at-action-sheet--active .at-action-sheet__container {
    -webkit-transform: translate3d(0,0,0);
    transform: translate3d(0,0,0)
}

